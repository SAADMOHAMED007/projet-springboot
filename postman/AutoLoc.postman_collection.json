                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dateDebut\": \"2026-11-20\",\n  \"dateFin\": \"2026-11-21\",\n  \"description\": \"Vidange\",\n  \"cout\": 250.00,\n  \"idVehicule\": {{vehiculeId}}\n}" },
            "url": "{{baseUrl}}/maintenances"
          }
        },
        { "name": "Lister les maintenances (200)", "request": { "method": "GET", "url": "{{baseUrl}}/maintenances" } },
        { "name": "Maintenance absente (404)", "request": { "method": "GET", "url": "{{baseUrl}}/maintenances/9999" } },
        {
          "name": "Maintenance invalide - coût négatif (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('cout signalé', () => pm.expect(body.errors).to.have.property('cout'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"dateDebut\": \"2026-11-20\", \"dateFin\": \"2026-11-21\", \"cout\": -1.00, \"idVehicule\": {{vehiculeId}} }" },
            "url": "{{baseUrl}}/maintenances"
          }
        }
      ]
    }
  ]
}
