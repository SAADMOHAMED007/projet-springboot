{
  "info": {
    "name": "AutoLoc - Atelier 6 (DTO + validation)",
    "description": "Scénarios CRUD avec DTO, validation des entrées et gestion centralisée des erreurs. baseUrl inclut le context-path /api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081/api" },
    { "key": "agenceId", "value": "" },
    { "key": "clientId", "value": "" },
    { "key": "equipementId", "value": "" },
    { "key": "vehiculeId", "value": "" },
    { "key": "reservationId", "value": "" },
    { "key": "contratId", "value": "" },
    { "key": "paiementId", "value": "" }
  ],
  "item": [
    {
      "name": "Agences",
      "item": [
        {
          "name": "Créer agence (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('agenceId', body.idAgence);",
                  "pm.test('201 et DTO de réponse', () => pm.response.to.have.status(201));",
                  "pm.test('Aucun graphe employés/vehicules exposé', () => { pm.expect(body).to.not.have.property('employes'); pm.expect(body).to.not.have.property('vehicules'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Agence Tunis\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"Centre-ville\",\n  \"telephone\": \"71123456\"\n}" },
            "url": "{{baseUrl}}/agences"
          }
        },
        { "name": "Lister les agences (200)", "request": { "method": "GET", "url": "{{baseUrl}}/agences" } },
        { "name": "Agence absente (404)", "request": { "method": "GET", "url": "{{baseUrl}}/agences/9999" } },
        {
          "name": "Agence invalide - nom et ville vides (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('400 avec erreurs par champ', () => pm.response.to.have.status(400));",
                  "pm.test('nom et ville signalés', () => { pm.expect(body.errors).to.have.property('nom'); pm.expect(body.errors).to.have.property('ville'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"nom\": \" \", \"ville\": \"\" }" },
            "url": "{{baseUrl}}/agences"
          }
        }
      ]
    },
    {
      "name": "Équipements",
      "item": [
        {
          "name": "Créer équipement (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('equipementId', body.idEquipement);",
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"libelle\": \"GPS\", \"quantite\": 2 }" },
            "url": "{{baseUrl}}/equipements"
          }
        },
        { "name": "Lister les équipements (200)", "request": { "method": "GET", "url": "{{baseUrl}}/equipements" } },
        { "name": "Équipement absent (404)", "request": { "method": "GET", "url": "{{baseUrl}}/equipements/9999" } },
        {
          "name": "Équipement invalide - quantité négative (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('quantite signalée', () => pm.expect(body.errors).to.have.property('quantite'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"libelle\": \"GPS\", \"quantite\": -1 }" },
            "url": "{{baseUrl}}/equipements"
          }
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "Créer client (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('clientId', body.idClient);",
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Ben Ali\",\n  \"prenom\": \"Samir\",\n  \"email\": \"samir.benali@example.com\",\n  \"telephone\": \"98123456\",\n  \"numPermis\": \"TN-2026-001\",\n  \"dateInscription\": \"2026-10-01\"\n}" },
            "url": "{{baseUrl}}/clients"
          }
        },
        { "name": "Lister les clients (200)", "request": { "method": "GET", "url": "{{baseUrl}}/clients" } },
        { "name": "Client absent (404)", "request": { "method": "GET", "url": "{{baseUrl}}/clients/9999" } },
        {
          "name": "Client invalide - email invalide (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('email signalé', () => pm.expect(body.errors).to.have.property('email'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"nom\": \"Ben Ali\", \"prenom\": \"Samir\", \"email\": \"pas-un-email\" }" },
            "url": "{{baseUrl}}/clients"
          }
        }
      ]
    },
    {
      "name": "Employés",
      "item": [
        {
          "name": "Créer employé (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 et agence résumée', () => { pm.response.to.have.status(201); pm.expect(body).to.have.property('idAgence'); pm.expect(body).to.have.property('agenceNom'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Trabelsi\",\n  \"prenom\": \"Nadia\",\n  \"role\": \"MANAGER\",\n  \"idAgence\": {{agenceId}}\n}" },
            "url": "{{baseUrl}}/employes"
          }
        },
        { "name": "Lister les employés (200)", "request": { "method": "GET", "url": "{{baseUrl}}/employes" } },
        { "name": "Employé absent (404)", "request": { "method": "GET", "url": "{{baseUrl}}/employes/9999" } },
        {
          "name": "Employé invalide - nom absent (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('nom signalé', () => pm.expect(body.errors).to.have.property('nom'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"prenom\": \"Samir\", \"role\": \"AGENT\" }" },
            "url": "{{baseUrl}}/employes"
          }
        }
      ]
    },
    {
      "name": "Véhicules",
      "item": [
        {
          "name": "Créer véhicule (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('vehiculeId', body.idVehicule);",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('Équipements résumés sans cycle', () => { pm.expect(body.equipements).to.be.an('array'); pm.expect(body.equipements[0]).to.not.have.property('vehicules'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"immatriculation\": \"TN-1234\",\n  \"marque\": \"Renault\",\n  \"modele\": \"Clio\",\n  \"categorie\": \"CITADINE\",\n  \"tarifJournalier\": 120.00,\n  \"statut\": \"DISPONIBLE\",\n  \"idAgence\": {{agenceId}},\n  \"equipementIds\": [{{equipementId}}]\n}" },
            "url": "{{baseUrl}}/vehicules"
          }
        },
        { "name": "Lister les véhicules (200)", "request": { "method": "GET", "url": "{{baseUrl}}/vehicules" } },
        { "name": "Véhicule absent (404)", "request": { "method": "GET", "url": "{{baseUrl}}/vehicules/9999" } },
        {
          "name": "Véhicule invalide - tarif négatif et enums absentes (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('tarif, catégorie et statut signalés', () => { pm.expect(body.errors).to.have.property('tarifJournalier'); pm.expect(body.errors).to.have.property('categorie'); pm.expect(body.errors).to.have.property('statut'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"immatriculation\": \"TN-0000\",\n  \"marque\": \"Test\",\n  \"modele\": \"Test\",\n  \"tarifJournalier\": -1\n}" },
            "url": "{{baseUrl}}/vehicules"
          }
        },
        {
          "name": "Immatriculation déjà utilisée (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 conflit de données', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"immatriculation\": \"TN-1234\",\n  \"marque\": \"Peugeot\",\n  \"modele\": \"208\",\n  \"categorie\": \"CITADINE\",\n  \"tarifJournalier\": 110.00,\n  \"statut\": \"DISPONIBLE\"\n}" },
            "url": "{{baseUrl}}/vehicules"
          }
        }
      ]
    },
    {
      "name": "Réservations",
      "item": [
        {
          "name": "Créer réservation (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('reservationId', body.idReservation);",
                  "pm.test('201 et relations résumées', () => { pm.response.to.have.status(201); pm.expect(body).to.have.property('vehiculeImmatriculation'); pm.expect(body).to.have.property('clientNom'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dateDebut\": \"2026-11-10\",\n  \"dateFin\": \"2026-11-15\",\n  \"statut\": \"CONFIRMEE\",\n  \"idVehicule\": {{vehiculeId}},\n  \"idClient\": {{clientId}}\n}" },
            "url": "{{baseUrl}}/reservations"
          }
        },
        { "name": "Lister les réservations (200)", "request": { "method": "GET", "url": "{{baseUrl}}/reservations" } },
        { "name": "Réservation absente (404)", "request": { "method": "GET", "url": "{{baseUrl}}/reservations/9999" } },
        {
          "name": "Réservation invalide - dates inversées (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 règle métier', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dateDebut\": \"2026-11-10\",\n  \"dateFin\": \"2026-11-09\",\n  \"statut\": \"EN_ATTENTE\",\n  \"idVehicule\": {{vehiculeId}},\n  \"idClient\": {{clientId}}\n}" },
            "url": "{{baseUrl}}/reservations"
          }
        },
        {
          "name": "Référence inexistante - véhicule 9999 (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 sur référence', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dateDebut\": \"2026-11-10\",\n  \"dateFin\": \"2026-11-15\",\n  \"statut\": \"EN_ATTENTE\",\n  \"idVehicule\": 9999,\n  \"idClient\": {{clientId}}\n}" },
            "url": "{{baseUrl}}/reservations"
          }
        }
      ]
    },
    {
      "name": "Contrats",
      "item": [
        {
          "name": "Créer un contrat avec ses paiements (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const contrat = pm.response.json();",
                  "pm.collectionVariables.set('contratId', contrat.idContrat);",
                  "if (contrat.paiements && contrat.paiements.length) pm.collectionVariables.set('paiementId', contrat.paiements[0].idPaiement);",
                  "pm.test('Contrat créé avec 201', () => pm.response.to.have.status(201));",
                  "pm.test('Deux paiements DTO', () => pm.expect(contrat.paiements).to.have.length(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dateSignature\": \"2026-11-02\",\n  \"montantTotal\": 480.00,\n  \"valide\": true,\n  \"idReservation\": {{reservationId}},\n  \"paiements\": [\n    { \"montant\": 150.00, \"datePaiement\": \"2026-11-02\", \"modePaiement\": \"CARTE\" },\n    { \"montant\": 330.00, \"datePaiement\": \"2026-11-06\", \"modePaiement\": \"VIREMENT\" }\n  ]\n}" },
            "url": "{{baseUrl}}/contrats"
          }
        },
        { "name": "Lister les contrats (200)", "request": { "method": "GET", "url": "{{baseUrl}}/contrats" } },
        { "name": "Contrat absent (404)", "request": { "method": "GET", "url": "{{baseUrl}}/contrats/9999" } },
        {
          "name": "Modifier le contrat sans toucher aux paiements (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 et paiements conservés', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().paiements).to.have.length(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"dateSignature\": \"2026-11-02\", \"montantTotal\": 520.00, \"valide\": true }" },
            "url": "{{baseUrl}}/contrats/{{contratId}}"
          }
        },
        {
          "name": "Montant négatif (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('montantTotal signalé', () => pm.expect(body.errors).to.have.property('montantTotal'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"dateSignature\": \"2026-11-02\", \"montantTotal\": -1.00, \"valide\": true }" },
            "url": "{{baseUrl}}/contrats"
          }
        },
        {
          "name": "Contrat absent en modification (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"dateSignature\": \"2026-11-02\", \"montantTotal\": 520.00 }" },
            "url": "{{baseUrl}}/contrats/9999"
          }
        },
        { "name": "Supprimer le contrat et ses paiements (204)", "request": { "method": "DELETE", "url": "{{baseUrl}}/contrats/{{contratId}}" } }
      ]
    },
    {
      "name": "Paiements",
      "item": [
        { "name": "Lister les paiements (200)", "request": { "method": "GET", "url": "{{baseUrl}}/paiements" } },
        { "name": "Paiement absent (404)", "request": { "method": "GET", "url": "{{baseUrl}}/paiements/9999" } },
        {
          "name": "Créer un paiement séparément (405 attendu)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('405 méthode non supportée', () => pm.response.to.have.status(405));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"montant\": 10.00 }" },
            "url": "{{baseUrl}}/paiements"
          }
        },
        {
          "name": "Vérifier la suppression en cascade (404 attendu)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 après cascade', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/paiements/{{paiementId}}" }
        }
      ]
    },
    {
      "name": "Maintenances",
      "item": [
        {
          "name": "Créer maintenance (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
